              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "user"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Logout",
